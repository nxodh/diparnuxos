#!/bin/sh
# Diparnux live-build 설정 스크립트 (lb config 의 auto 관례).
# diparnux.conf 값을 읽어 lb config noauto 를 호출한다. lb config 는 build/ 디렉터리에서 ./auto/config 로 실행한다.
set -eu

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
DIPARNUX_CONF="${DIPARNUX_CONF:-${ROOT}/diparnux.conf}"

if [ ! -r "${DIPARNUX_CONF}" ]; then
    echo "auto/config: diparnux.conf 를 읽을 수 없다: ${DIPARNUX_CONF}" >&2
    exit 1
fi

# shellcheck source=/dev/null
. "${DIPARNUX_CONF}"

INCLUDES_APT_DIR="config/includes.chroot/etc/apt/apt.conf.d"
SNAPSHOT_APT_CONF="${INCLUDES_APT_DIR}/90diparnux-snapshot"

if [ -n "${DEBIAN_SNAPSHOT}" ]; then
    if ! echo "${DEBIAN_SNAPSHOT}" | grep -Eq '^[0-9]{8}T[0-9]{6}Z$'; then
        echo "auto/config: DEBIAN_SNAPSHOT 형식이 YYYYMMDDTHHMMSSZ 가 아니다: ${DEBIAN_SNAPSHOT}" >&2
        exit 1
    fi
    mirror="${DEBIAN_SNAPSHOT_URL}/debian/${DEBIAN_SNAPSHOT}/"
    security_mirror="${DEBIAN_SNAPSHOT_URL}/debian-security/${DEBIAN_SNAPSHOT}/"
    apt_options="--yes -o Acquire::Retries=5 -o Acquire::Check-Valid-Until=false"

    # 설치된 시스템의 apt 도 snapshot 의 만료된 Release 를 거부하지 않도록 한다.
    mkdir -p "${INCLUDES_APT_DIR}"
    cat > "${SNAPSHOT_APT_CONF}" <<'EOF'
Acquire::Check-Valid-Until "false";
EOF
else
    mirror="${DEBIAN_MIRROR}/"
    security_mirror="${DEBIAN_SECURITY_MIRROR}/"
    apt_options="--yes -o Acquire::Retries=5"
    rm -f "${SNAPSHOT_APT_CONF}"
fi

# 커널 명령줄의 마지막 console= 이 /dev/console 이 된다(Documentation/admin-guide/serial-console.rst).
# 그래서 tty0 를 마지막에 둔다. 그러면 systemd 와 서비스의 출력은 /dev/console 인 tty0(모니터)로 간다.
# 커널 메시지는 두 콘솔 모두에 나온다. 직렬 포트의 로그인 프롬프트는 systemd-getty-generator 가
# console=ttyS0 를 보고 serial-getty@ttyS0 로 띄운다(systemd-getty-generator(8)). 실기 모니터 표시는 미검증이다.
# --apt-indices false: apt 목록(/var/lib/apt/lists)을 이미지에 넣지 않는다. 설치 후 apt 는 apt-get update 가 필요하다.
# --apt-source-archives false: deb-src 항목을 최종 sources.list 에서 주석 처리한다(lb_config(1)).
lb config noauto \
    --distribution "${DEBIAN_SUITE}" \
    --architecture amd64 \
    --archive-areas "${DEBIAN_AREAS}" \
    --binary-image iso-hybrid \
    --bootloaders grub-efi \
    --debian-installer none \
    --debootstrap-options "--include=ca-certificates" \
    --backports false \
    --security true \
    --updates true \
    --apt-recommends false \
    --apt-indices false \
    --apt-source-archives false \
    --firmware-chroot false \
    --firmware-binary false \
    --apt-options "${apt_options}" \
    --linux-packages "linux-image linux-headers" \
    --mirror-bootstrap "${mirror}" \
    --mirror-chroot "${mirror}" \
    --mirror-binary "${mirror}" \
    --mirror-chroot-security "${security_mirror}" \
    --mirror-binary-security "${security_mirror}" \
    --bootappend-live "boot=live components console=ttyS0,115200 console=tty0 hostname=${DIPARNUX_ID}" \
    --iso-volume "${DIPARNUX_NAME}" \
    --iso-application "${DIPARNUX_NAME}" \
    --iso-publisher "${DIPARNUX_NAME}" \
    --image-name "${DIPARNUX_ID}-${DIPARNUX_VERSION}" \
    ${1+"$@"}
