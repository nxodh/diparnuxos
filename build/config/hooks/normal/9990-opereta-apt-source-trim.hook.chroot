#!/bin/sh
# Opereta 업데이트 저장소 소스는 이미지를 만드는 동안 apt 가 보면 안 된다. 첫 릴리스 전이거나 GitHub 에 닿지 못하면
# 저장소에 Release 파일이 없는 것이 영구 오류라서 마지막 apt-get update 가 이미지 빌드를 실패시킨다.
#
# opereta-archive-keyring 은 소스를 /usr/share/opereta/apt 에 템플릿으로 두고 첫 부팅 때 systemd-tmpfiles 가
# /etc/apt/sources.list.d 로 복사한다. 그런데 이미지를 만드는 동안 다른 패키지의 설정 단계가 systemd-tmpfiles 를
# 실행하면 그 파일이 chroot 안에 미리 만들어진다. 마지막 apt-get update 앞에서 지운다. 첫 부팅 때 다시 만들어진다.
set -e
rm -f /etc/apt/sources.list.d/opereta.sources
[ -s /usr/share/opereta/apt/opereta.sources ] || { echo "opereta-apt-source-trim: the template is missing" >&2; exit 1; }
echo "opereta-apt-source-trim: the Opereta apt source is created at first boot"
