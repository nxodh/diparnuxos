#!/bin/sh
# openssh-server 의 postinst 는 호스트 키를 만든다. 그대로 두면 이 이미지를 받은 모든 기기가 같은 호스트 키를 갖는다.
# 그래서 키를 지우고, 서버 유닛은 꺼 둔다. 켤 때 operetad 가 ssh-keygen -A 로 없는 키를 만든다.
# sshd-keygen.service 는 건드리지 않는다. ssh.service 가 켜질 때 따라 시작되어 부팅 때도 없는 키를 만든다.
set -e

rm -f /etc/ssh/ssh_host_*
systemctl disable ssh.service ssh.socket

for unit in ssh.service ssh.socket; do
    if [ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" = enabled ]; then
        echo "opereta-ssh: $unit 이 아직 켜져 있다" >&2
        exit 1
    fi
done
if ls /etc/ssh/ssh_host_* >/dev/null 2>&1; then
    echo "opereta-ssh: 호스트 키가 남아 있다" >&2
    exit 1
fi
echo 'opereta-ssh: 호스트 키 제거와 서버 유닛 비활성화 완료'
