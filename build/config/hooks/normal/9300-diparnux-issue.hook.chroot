#!/bin/sh
# 로그인 배너(/etc/issue, /etc/issue.net)를 Diparnux 한 줄로 다시 쓴다(리뷰 minor 6).
# 값은 /usr/lib/os-release 의 NAME 과 VERSION_ID 에서 읽고, Debian 주 버전은 /etc/debian_version 에서 읽는다.
# /etc/issue 는 agetty 이스케이프 \n(커널 릴리스)와 \l(tty 이름)을 유지한다.
# 9900 훅이 /etc/issue 끝에 라이선스 안내를 덧붙이므로, 이 훅은 9900 보다 먼저 실행되어야 한다(번호 순서).
# 이 훅이 파일을 통째로 다시 쓰는 곳은 여기뿐이다.
set -eu

fail() {
    echo "diparnux-issue: $*" >&2
    exit 1
}

[ -r /usr/lib/os-release ] || fail '/usr/lib/os-release 를 읽을 수 없다'
[ -r /etc/debian_version ] || fail '/etc/debian_version 을 읽을 수 없다'

# shellcheck source=/dev/null
name="$(. /usr/lib/os-release && printf '%s' "${NAME:-}")"
# shellcheck source=/dev/null
version="$(. /usr/lib/os-release && printf '%s' "${VERSION_ID:-}")"
[ -n "$name" ] || fail 'os-release 에 NAME 이 없다'
[ -n "$version" ] || fail 'os-release 에 VERSION_ID 가 없다'

debian_major="$(cut -d. -f1 /etc/debian_version)"
case "$debian_major" in
    ''|*[!0-9]*) fail "Debian 주 버전을 알 수 없다: $(cat /etc/debian_version)" ;;
esac

line="$name $version (based on Debian $debian_major)"
# 실기 텍스트 콘솔은 한글을 표시하지 못하므로 ASCII 만 허용한다.
if printf '%s' "$line" | LC_ALL=C grep -q '[^ -~]'; then
    fail "배너에 ASCII 가 아닌 문자가 있다: $line"
fi

printf '%s \\n \\l\n\n' "$line" > /etc/issue
printf '%s\n' "$line" > /etc/issue.net
chmod 0644 /etc/issue /etc/issue.net
echo "diparnux-issue: 배너 설정 완료: $line"
