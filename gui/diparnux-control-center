#!/usr/bin/python3
"""diparnux-control-center 실행 파일. 패키지 설치 경로를 sys.path 에 넣고 앱을 시작한다."""

import os
import sys

# 설정 앱이라 GL 렌더러가 필요 없다. cairo 렌더러는 메모리를 크게 줄인다(소프트웨어 GL 에서 PSS 295 MiB → 168 MiB).
# 사용자가 따로 정한 값이 있으면 따른다.
os.environ.setdefault("GSK_RENDERER", "cairo")

_here = os.path.dirname(os.path.abspath(__file__))
for candidate in (os.path.join(_here, "..", "lib", "diparnux", "control-center"), _here):
    if os.path.isdir(os.path.join(candidate, "diparnux_cc")):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from diparnux_cc.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
