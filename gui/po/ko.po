msgid "This computer has no Bluetooth adapter."
msgstr "이 컴퓨터에는 블루투스 어댑터가 없습니다."

msgid "Bluetooth is switched off"
msgstr "블루투스가 꺼져 있습니다"

msgid "A hardware switch or key has turned Bluetooth off. Turn it on, then come back."
msgstr "하드웨어 스위치나 키가 블루투스를 껐습니다. 켠 뒤에 다시 확인하세요."

msgid "Bluetooth is blocked"
msgstr "블루투스가 차단되어 있습니다"

msgid "Bluetooth is blocked by software, for example by airplane mode. Unblock it with 'rfkill unblock bluetooth'."
msgstr "비행기 모드처럼 소프트웨어가 블루투스를 막고 있습니다. 'rfkill unblock bluetooth' 로 풀 수 있습니다."

msgid "The Bluetooth service is not running"
msgstr "블루투스 서비스가 실행 중이 아닙니다"

msgid "An adapter exists, but the Bluetooth service has stopped. Start it on the Services page."
msgstr "어댑터는 있으나 블루투스 서비스가 멈춰 있습니다. 서비스 쪽에서 시작하세요."

msgid "Bluetooth did not answer"
msgstr "블루투스가 응답하지 않습니다"

msgid "The Bluetooth service took too long to respond. Try again in a moment."
msgstr "블루투스 서비스의 응답이 너무 늦습니다. 잠시 뒤에 다시 시도하세요."

msgid "Bluetooth tools are missing"
msgstr "블루투스 도구가 없습니다"

msgid "The bluetoothctl command is not installed on this system."
msgstr "이 시스템에 bluetoothctl 명령이 없습니다."

msgid "No Bluetooth adapter"
msgstr "블루투스 어댑터 없음"

msgid "This computer has no Bluetooth adapter, or the Bluetooth service is not running."
msgstr "이 컴퓨터에 블루투스 어댑터가 없거나 블루투스 서비스가 실행 중이 아닙니다."

msgid "Paired"
msgstr "페어링됨"

msgid "Not paired"
msgstr "페어링 안 됨"

msgid "Pair"
msgstr "페어링"

msgid "Searching for devices…"
msgstr "기기를 검색하는 중…"

msgid "The command failed"
msgstr "명령이 실패했습니다"

msgid "Pairing failed. Check that the device is in pairing mode."
msgstr "페어링에 실패했습니다. 기기가 페어링 모드인지 확인하세요."

msgid "Keyboard"
msgstr "키보드"

msgid "Typing languages"
msgstr "입력 언어"

msgid "Keyboard layout"
msgstr "키보드 배열"

msgid "Switch between English and Korean"
msgstr "영어와 한국어 전환"

msgid "Press the Hangul key, the right Alt key, Shift+Space or Ctrl+Space."
msgstr "한/영 키, 오른쪽 Alt 키, Shift+Space 또는 Ctrl+Space 를 누르세요."

msgid "Input method settings"
msgstr "입력기 설정"

msgid "Add languages or change the switching keys."
msgstr "언어를 추가하거나 전환 키를 바꿉니다."

msgid "Key repeat"
msgstr "키 반복"

msgid "Delay before repeating (ms)"
msgstr "반복 전 지연(ms)"

msgid "Repeats per second"
msgstr "초당 반복 횟수"

msgid "The input method settings could not be opened"
msgstr "입력기 설정을 열 수 없습니다"

msgid "Storage"
msgstr "저장 공간"

msgid "Model files"
msgstr "모델 파일"

msgid "Downloaded models"
msgstr "내려받은 모델"

msgid "%(n)d models, %(size)s"
msgstr "모델 %(n)d개, %(size)s"

msgid "The disk list could not be read."
msgstr "디스크 목록을 읽지 못했습니다."

msgid "Disk"
msgstr "디스크"

msgid "Partition"
msgstr "파티션"

msgid "CUDA runtime"
msgstr "CUDA 런타임"

msgid "GPU acceleration needs NVIDIA's CUDA runtime. It is not part of Opereta: this computer downloads it directly from NVIDIA."
msgstr "GPU 가속에는 NVIDIA 의 CUDA 런타임이 필요합니다. Opereta 에 포함되어 있지 않고, 이 컴퓨터가 NVIDIA 에서 직접 내려받습니다."

msgid "Restart the model server"
msgstr "모델 서버 다시 시작"

msgid "Restart it so the model uses the GPU after the runtime is installed."
msgstr "런타임을 설치한 뒤 모델이 GPU 를 쓰도록 다시 시작합니다."

msgid "CUDA supported by the driver"
msgstr "드라이버가 지원하는 CUDA"

msgid "Downloading and installing…"
msgstr "내려받아 설치하는 중…"

msgid "Start a model from the Server page."
msgstr "서버 페이지에서 모델을 시작하세요."

msgid "The model server is restarting"
msgstr "모델 서버를 다시 시작하는 중입니다"

msgid "Home"
msgstr "홈"

msgid "Overview"
msgstr "개요"

msgid "The state of this computer at a glance. Select a row to open its page."
msgstr "이 컴퓨터의 상태를 한눈에 봅니다. 줄을 누르면 해당 페이지가 열립니다."

msgid "Download the CUDA runtime"
msgstr "CUDA 런타임 내려받기"

msgid "The CUDA backend did not load. Open Graphics: download the CUDA runtime if it is missing, then run the GPU check."
msgstr "CUDA 백엔드를 불러오지 못했습니다. 그래픽 페이지에서 CUDA 런타임이 없으면 내려받고 GPU 점검을 실행하세요."

msgid "No GPU acceleration needed"
msgstr "GPU 가속이 필요 없습니다"

msgid "There is no NVIDIA GPU, so models run on the CPU."
msgstr "NVIDIA GPU 가 없어서 모델은 CPU 로 실행됩니다."

msgid "GPU acceleration is ready"
msgstr "GPU 가속을 쓸 수 있습니다"

msgid "The CUDA runtime is installed."
msgstr "CUDA 런타임이 설치되어 있습니다."

msgid "GPU acceleration is not available"
msgstr "GPU 가속을 쓸 수 없습니다"

msgid "GPU acceleration needs the CUDA runtime"
msgstr "GPU 가속에는 CUDA 런타임이 필요합니다"

msgid "NVIDIA's CUDA runtime is not part of Opereta; this computer downloads it from NVIDIA (about 360 MiB). Without it models run on the CPU. You can skip this and do it later in Graphics."
msgstr "NVIDIA 의 CUDA 런타임은 Opereta 에 포함되어 있지 않고 이 컴퓨터가 NVIDIA 에서 내려받습니다(약 360 MiB). 없으면 모델이 CPU 로 실행됩니다. 건너뛰고 나중에 그래픽 페이지에서 해도 됩니다."

msgid "GPU acceleration needs the CUDA runtime from NVIDIA. Until it is installed, models run on the CPU."
msgstr "GPU 가속에는 NVIDIA 의 CUDA 런타임이 필요합니다. 설치하기 전에는 모델이 CPU 로 실행됩니다."

msgid "Running from the installation image. Startup settings are available after Opereta is installed."
msgstr "설치 전 이미지로 실행 중입니다. 시작 설정은 Opereta 를 설치한 뒤에 사용할 수 있습니다."

msgid "Boot information is not available."
msgstr "부팅 정보를 볼 수 없습니다."

msgid "This computer was not started in UEFI mode. Boot entries are not available."
msgstr "이 컴퓨터는 UEFI 모드로 시작하지 않았습니다. 부팅 항목을 쓸 수 없습니다."

msgid "UEFI mode, but the boot entries could not be read."
msgstr "UEFI 모드이지만 부팅 항목을 읽지 못했습니다."

msgid "Started from: %s"
msgstr "이번에 시작한 항목: %s"

msgid "This computer was not started in UEFI mode. Restart it in UEFI mode (turn off CSM or legacy boot in the firmware settings)."
msgstr "이 컴퓨터는 UEFI 모드로 시작하지 않았습니다. UEFI 모드로 다시 시작하세요(펌웨어 설정에서 CSM 또는 레거시 부팅을 끕니다)."

msgid "The firmware has no 'opereta' boot entry. Use Repair to create it."
msgstr "펌웨어에 'opereta' 부팅 항목이 없습니다. 복구로 만드세요."

msgid "The firmware starts another system before Opereta. Choose Opereta for the next start below."
msgstr "펌웨어가 Opereta 보다 다른 시스템을 먼저 시작합니다. 아래에서 다음 시작을 Opereta 로 고르세요."

msgid "This firmware rewrites the boot order after it is set. Use the next-start choice below, or turn on 'Start Opereta again after shutting down'."
msgstr "이 펌웨어는 부팅 순서를 정해도 다시 바꿔 씁니다. 아래의 다음 시작 선택을 쓰거나 '끄거나 다시 시작한 뒤에도 Opereta 로 시작'을 켜세요."

msgid "Folders or boot entries from an earlier name of this system remain. You can remove them below."
msgstr "이 시스템의 이전 이름이 남긴 폴더나 부팅 항목이 있습니다. 아래에서 지울 수 있습니다."

msgid "The EFI system partition is not mounted."
msgstr "EFI 시스템 파티션이 마운트되어 있지 않습니다."

msgid "The fallback boot file is missing. Use Repair to restore it."
msgstr "대체 부팅 파일이 없습니다. 복구로 되살리세요."

msgid "CUDA runtime missing"
msgstr "CUDA 런타임 없음"

msgid "%d things need attention"
msgstr "주의가 필요한 것 %d개"

msgid "Running from the installation image"
msgstr "설치 전 이미지로 실행 중"

msgid "Boot entries look fine"
msgstr "부팅 항목이 정상입니다"

msgid "Open Graphics"
msgstr "그래픽 열기"

msgid "AI"
msgstr "AI"

msgid "GPU acceleration"
msgstr "GPU 가속"

msgid "NVIDIA's license applies: https://docs.nvidia.com/cuda/eula/index.html . The download runs in the background."
msgstr "NVIDIA 의 라이선스가 적용됩니다: https://docs.nvidia.com/cuda/eula/index.html . 내려받기는 백그라운드에서 진행됩니다."

msgid "Download started. You can follow it in Graphics."
msgstr "내려받기를 시작했습니다. 그래픽 페이지에서 진행을 볼 수 있습니다."
