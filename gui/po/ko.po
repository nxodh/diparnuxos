msgstr "데스크톱 모드"

msgid "Server mode"
msgstr "서버 모드"

msgid "%(n)d of %(total)d layers on the GPU"
msgstr "레이어 %(total)d개 중 %(n)d개가 GPU에 있음"

msgid "No NVIDIA GPU found"
msgstr "NVIDIA GPU를 찾지 못했습니다"

msgid "The model will run on the CPU. Inference is slower without a GPU."
msgstr "모델은 CPU에서 실행됩니다. GPU가 없으면 추론이 느립니다."

msgid "The NVIDIA driver is not loaded"
msgstr "NVIDIA 드라이버가 로드되지 않았습니다"

msgid "The GPU is present but the kernel module did not load. Check the driver report in the System page."
msgstr "GPU는 있지만 커널 모듈이 로드되지 않았습니다. 시스템 페이지의 드라이버 리포트를 확인하세요."

msgid "Secure Boot blocks the NVIDIA driver"
msgstr "보안 부팅이 NVIDIA 드라이버를 막고 있습니다"

msgid "Secure Boot is on, so the unsigned NVIDIA module cannot load. Turn Secure Boot off in the firmware settings, or enroll a key (see the Secure Boot step)."
msgstr "보안 부팅이 켜져 있어 서명되지 않은 NVIDIA 모듈을 로드할 수 없습니다. 펌웨어 설정에서 보안 부팅을 끄거나 키를 등록하세요(보안 부팅 단계 참고)."

msgid "A proprietary NVIDIA module is loaded"
msgstr "독점 NVIDIA 모듈이 로드되어 있습니다"

msgid "Lightlix needs the open kernel modules. Reinstall the image or remove the proprietary driver."
msgstr "Lightlix는 오픈 커널 모듈이 필요합니다. 이미지를 다시 설치하거나 독점 드라이버를 제거하세요."

msgid "Driver and library versions differ"
msgstr "드라이버와 라이브러리 버전이 다릅니다"

msgid "Reboot so the loaded kernel module matches the installed driver libraries."
msgstr "로드된 커널 모듈이 설치된 드라이버 라이브러리와 맞도록 재부팅하세요."

msgid "The NVIDIA driver is missing"
msgstr "NVIDIA 드라이버가 없습니다"

msgid "The driver packages are not installed in this image."
msgstr "이 이미지에 드라이버 패키지가 설치되어 있지 않습니다."

msgid "The GPU did not answer"
msgstr "GPU가 응답하지 않습니다"

msgid "The driver is loaded but querying the GPU failed. Run the check again after a reboot."
msgstr "드라이버는 로드되었지만 GPU 조회에 실패했습니다. 재부팅한 뒤 검사를 다시 실행하세요."

msgid "This GPU is not supported"
msgstr "지원하지 않는 GPU입니다"

msgid "Only RTX 30, 40 and 50 series GPUs are supported. The model will run on the CPU."
msgstr "RTX 30, 40, 50 시리즈만 지원합니다. 모델은 CPU에서 실행됩니다."

msgid "The diagnostic configuration is missing"
msgstr "진단 설정이 없습니다"

msgid "The GPU check could not read its configuration. Reinstall the image."
msgstr "GPU 검사가 설정을 읽지 못했습니다. 이미지를 다시 설치하세요."

msgid "The GPU check failed"
msgstr "GPU 검사에 실패했습니다"

msgid "The diagnostic script hit an internal error. Export the report from the System page."
msgstr "진단 스크립트에서 내부 오류가 났습니다. 시스템 페이지에서 리포트를 내보내세요."

msgid "Stopped"
msgstr "중지됨"

msgid "Starting"
msgstr "시작하는 중"

msgid "Running on GPU"
msgstr "GPU에서 실행 중"

msgid "Running on CPU"
msgstr "CPU에서 실행 중"

msgid "Failed"
msgstr "실패"

msgid "Unknown architecture"
msgstr "알 수 없는 아키텍처"

msgid "GPU status is not available yet"
msgstr "GPU 상태를 아직 알 수 없습니다"

msgid "The GPU check has not produced a result: %s"
msgstr "GPU 검사가 결과를 내지 않았습니다: %s"

msgid "The GPU check has not run."
msgstr "GPU 검사가 아직 실행되지 않았습니다."

msgid "Unknown GPU state: %s"
msgstr "알 수 없는 GPU 상태: %s"

msgid "Run the GPU check to detect your GPU."
msgstr "GPU 검사를 실행해 GPU를 감지하세요."

msgid "You can still use Lightlix on the CPU."
msgstr "GPU가 없어도 CPU로 Lightlix를 쓸 수 있습니다."

msgid "GPU detected"
msgstr "GPU를 감지했습니다"

msgid "%(names)s (%(usable)d of %(total)d usable)"
msgstr "%(names)s (%(total)d개 중 %(usable)d개 사용 가능)"

msgid "GPU detected but not usable"
msgstr "GPU를 감지했지만 사용할 수 없습니다"

msgid "Driver status is not available yet"
msgstr "드라이버 상태를 아직 알 수 없습니다"

msgid "Driver %s"
msgstr "드라이버 %s"

msgid "open kernel module"
msgstr "오픈 커널 모듈"

msgid "The NVIDIA driver works"
msgstr "NVIDIA 드라이버가 정상 동작합니다"

msgid "No driver check needed"
msgstr "드라이버 검사가 필요 없습니다"

msgid "There is no NVIDIA GPU."
msgstr "NVIDIA GPU가 없습니다."

msgid "Secure Boot is on and blocks the driver"
msgstr "보안 부팅이 켜져 있고 드라이버를 막고 있습니다"

msgid "Turn Secure Boot off in the firmware settings and reboot. On an installed system you can enroll a machine key instead: run 'sudo lightlix-mok enroll' in a terminal."
msgstr "펌웨어 설정에서 보안 부팅을 끄고 재부팅하세요. 설치된 시스템에서는 대신 기기 키를 등록할 수 있습니다. 터미널에서 'sudo lightlix-mok enroll'을 실행하세요."

msgid "Secure Boot is on"
msgstr "보안 부팅이 켜져 있습니다"

msgid "The NVIDIA driver loaded, so no action is needed."
msgstr "NVIDIA 드라이버가 로드되었으므로 할 일이 없습니다."

msgid "Secure Boot is off"
msgstr "보안 부팅이 꺼져 있습니다"

msgid "The NVIDIA module can load without a signature."
msgstr "NVIDIA 모듈을 서명 없이 로드할 수 있습니다."

msgid "Secure Boot state is unknown"
msgstr "보안 부팅 상태를 알 수 없습니다"

msgid "This machine may not use UEFI Secure Boot."
msgstr "이 기기는 UEFI 보안 부팅을 쓰지 않을 수 있습니다."

msgid "Enter a user name."
msgstr "사용자 이름을 입력하세요."

msgid "The user name can have at most 32 characters."
msgstr "사용자 이름은 32자 이하여야 합니다."

msgid "The user name must start with a lowercase letter."
msgstr "사용자 이름은 영문 소문자로 시작해야 합니다."

msgid "Use only lowercase letters, digits, _ and - in the user name."
msgstr "사용자 이름에는 영문 소문자, 숫자, _ 와 - 만 쓸 수 있습니다."

msgid "This user name is reserved. Choose another one."
msgstr "예약된 사용자 이름입니다. 다른 이름을 고르세요."

msgid "The password must have at least 8 characters."
msgstr "비밀번호는 8자 이상이어야 합니다."

msgid "The password can have at most 128 characters."
msgstr "비밀번호는 128자 이하여야 합니다."

msgid "Use only printable ASCII characters in the password."
msgstr "비밀번호에는 출력 가능한 ASCII 문자만 쓸 수 있습니다."

msgid "The password must differ from the user name."
msgstr "비밀번호는 사용자 이름과 달라야 합니다."

msgid "The two passwords do not match."
msgstr "두 비밀번호가 서로 다릅니다."

msgid "A login account exists"
msgstr "로그인 계정이 있습니다"

msgid "Create your own login account"
msgstr "나만의 로그인 계정을 만드세요"

msgid "Without one you can only use the default live account. Choose a user name and a password."
msgstr "없으면 기본 live 계정만 쓸 수 있습니다. 사용자 이름과 비밀번호를 정하세요."

msgid "A model is already installed"
