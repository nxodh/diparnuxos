<?xml version="1.0" encoding="UTF-8"?>
<!-- Opereta 창 관리자 기본값. 합성(그림자, 둥근 모서리, 흐림)은 picom 이 한다(opereta-compositor). xfwm4 자신의 합성은 끈다.
     picom 을 시작하지 못하면 opereta-compositor 가 xfwm4 의 합성을 켠다. -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Opereta"/>
    <property name="title_font" type="string" value="Pretendard SemiBold 10"/>
    <property name="button_layout" type="string" value="CMH|"/>
    <property name="title_alignment" type="string" value="center"/>
    <property name="use_compositing" type="bool" value="false"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="show_popup_shadow" type="bool" value="true"/>
    <property name="workspace_count" type="int" value="2"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="focus_hint" type="bool" value="true"/>
  </property>
</channel>
