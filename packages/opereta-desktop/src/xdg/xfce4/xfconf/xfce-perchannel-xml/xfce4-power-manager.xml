<?xml version="1.0" encoding="UTF-8"?>
<!--
  Opereta 상시 가동: 데스크톱에서도 절전하지 않는다. 시스템 수준에서는 systemd 설정이 이미 절전을 막지만
  (opereta power), 이 값으로 전원 관리자가 덮개나 유휴 때문에 요청을 시도하지도 않게 한다.
  동작 값 0 은 아무것도 안 함이다. 유휴 시간 14 는 "안 함"이다.
  전원 버튼(power-button-action)은 Debian 의 기본값을 그대로 둔다. 사용자가 직접 끄는 길을 막지 않는다.
-->
<channel name="xfce4-power-manager" version="1.0">
  <property name="xfce4-power-manager" type="empty">
    <property name="lid-action-on-ac" type="uint" value="0"/>
    <property name="lid-action-on-battery" type="uint" value="0"/>
    <property name="inactivity-on-ac" type="uint" value="14"/>
    <property name="inactivity-on-battery" type="uint" value="14"/>
    <property name="sleep-button-action" type="uint" value="0"/>
    <property name="hibernate-button-action" type="uint" value="0"/>
    <property name="battery-button-action" type="uint" value="0"/>
    <property name="critical-power-action" type="uint" value="0"/>
    <property name="logind-handle-lid-switch" type="bool" value="false"/>
    <property name="logind-handle-suspend-key" type="bool" value="false"/>
    <property name="logind-handle-hibernate-key" type="bool" value="false"/>
    <property name="lock-screen-suspend-hibernate" type="bool" value="false"/>
  </property>
</channel>
