# Opereta 독 테마(밝은 쪽). 설치 경로는 /usr/share/plank/themes/Opereta/dock.theme 이다. 색은 R;;G;;B;;A(0~255)다.
[PlankDockTheme]
HorizPadding=6
TopPadding=-4
BottomPadding=4
ItemPadding=6
IndicatorSize=5
IconShadowSize=0
UrgentBounceHeight=1.6
LaunchBounceHeight=0.5
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=0
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
BadgeColor=60;;60;;64;;255

[PlankDrawingTheme]
TopRoundness=18
BottomRoundness=18
LineWidth=1
OuterStrokeColor=210;;210;;213;;230
FillStartColor=248;;248;;250;;190
FillEndColor=236;;236;;240;;190
InnerStrokeColor=255;;255;;255;;120
