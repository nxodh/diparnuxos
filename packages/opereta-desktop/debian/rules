#!/usr/bin/make -f
# 파일 복사만 한다. 서비스 유닛은 lightdm 패키지가 소유한다. 라이브 자동 로그인은 live-config 의 lightdm 구성 요소가 맡는다.
# Debian 의 /etc/xdg 파일을 덮지 않도록 Opereta 기본값은 /etc/xdg/opereta 에 둔다.
D = debian/opereta-desktop
X = $(D)/etc/xdg/opereta/xfce4
G = assets/generated/xfwm4

%:
	dh $@

override_dh_auto_build:
	# 컴파일할 대상은 없다.

override_dh_auto_install:
	install -D -m 644 src/xdg/xfce4/panel/default.xml $(X)/panel/default.xml
	install -D -m 644 src/xdg/xfce4/panel/genmon-5.rc $(X)/panel/genmon-5.rc
	install -D -m 644 src/xdg/xfce4/whiskermenu/defaults.rc $(X)/whiskermenu/defaults.rc
	install -D -m 644 src/xdg/xfce4/terminal/terminalrc $(X)/terminal/terminalrc
	set -e; for f in xsettings xfwm4 xfce4-desktop xfce4-power-manager; do \
	  install -D -m 644 src/xdg/xfce4/xfconf/xfce-perchannel-xml/$$f.xml $(X)/xfconf/xfce-perchannel-xml/$$f.xml; \
	done
	install -D -m 644 src/xsession/55opereta-xdg $(D)/etc/X11/Xsession.d/55opereta-xdg
	install -D -m 644 src/autostart/opereta-session-setup.desktop $(D)/etc/xdg/autostart/opereta-session-setup.desktop
	set -e; for u in pipewire pipewire-pulse wireplumber; do \
	  install -D -m 644 src/systemd-user/$$u.service.conf $(D)/usr/lib/systemd/user/$$u.service.d/50-opereta-graphical-only.conf; \
	done
	install -D -m 644 src/xorg/90-opereta-keyboard.conf $(D)/etc/X11/xorg.conf.d/90-opereta-keyboard.conf
	install -D -m 644 src/autostart/opereta-fcitx5.desktop $(D)/etc/xdg/autostart/opereta-fcitx5.desktop
	install -D -m 644 src/autostart/opereta-control-center-wizard.desktop $(D)/etc/xdg/autostart/opereta-control-center-wizard.desktop
	install -D -m 644 src/firefox/opereta.js $(D)/usr/share/firefox-esr/browser/defaults/preferences/opereta.js
	install -D -m 644 src/fontconfig/60-opereta-pretendard.conf $(D)/etc/fonts/conf.d/60-opereta-pretendard.conf
	install -D -m 644 src/lightdm/50-opereta.conf $(D)/usr/share/lightdm/lightdm.conf.d/50-opereta.conf
	install -D -m 644 src/lightdm/50-opereta-greeter.conf $(D)/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-opereta.conf
	install -D -m 755 src/opereta-panel-net $(D)/usr/bin/opereta-panel-net
	install -D -m 755 src/opereta-session-setup $(D)/usr/bin/opereta-session-setup
	# 밝은 테마 Opereta 와 어두운 테마 Opereta-Dark. 파일은 scripts/make-theme.py 가 만든다.
	set -e; for t in Opereta:light Opereta-Dark:dark; do \
	  name=$${t%%:*}; scheme=$${t##*:}; T=$(D)/usr/share/themes/$$name; \
	  install -D -m 644 src/themes/$$name/index.theme $$T/index.theme; \
	  install -D -m 644 src/themes/$$name/gtk-3.0/gtk.css $$T/gtk-3.0/gtk.css; \
	  install -D -m 644 src/themes/$$name/xfwm4/themerc $$T/xfwm4/themerc; \
	  for f in src/themes/$$name/gtk-3.0/assets/*.png; do install -D -m 644 $$f $$T/gtk-3.0/assets/$$(basename $$f); done; \
	  for f in $(G)/$$scheme/*.png; do install -D -m 644 $$f $$T/xfwm4/$$(basename $$f); done; \
	done
	# 창 컨트롤 기호를 x, -, + 로 바꾸는 아이콘 테마(Adwaita 를 상속한다).
	install -D -m 644 src/icons/Opereta/index.theme $(D)/usr/share/icons/Opereta/index.theme
	set -e; for f in src/icons/Opereta/scalable/ui/*; do \
	  install -D -m 644 $$f $(D)/usr/share/icons/Opereta/scalable/ui/$$(basename $$f); \
	done
