#!/usr/bin/make -f
# 파일 복사만 한다. 서비스 유닛은 lightdm 패키지가 소유하며 이 패키지는 드롭인만 넣는다.
# Debian 의 /etc/xdg 파일을 덮지 않도록 Lightlix 기본값은 /etc/xdg/lightlix 에 둔다.
D = debian/lightlix-desktop
X = $(D)/etc/xdg/lightlix/xfce4
T = $(D)/usr/share/themes/Lightlix
G = assets/generated/xfwm4

%:
	dh $@

override_dh_auto_build:
	# 컴파일할 대상은 없다.

override_dh_auto_install:
	install -D -m 644 src/xdg/xfce4/panel/default.xml $(X)/panel/default.xml
	install -D -m 644 src/xdg/xfce4/panel/genmon-5.rc $(X)/panel/genmon-5.rc
	install -D -m 644 src/xdg/xfce4/whiskermenu/defaults.rc $(X)/whiskermenu/defaults.rc
	install -D -m 644 src/xdg/xfce4/terminal/terminalrc $(X)/terminal/terminalrc
	set -e; for f in xsettings xfwm4 xfce4-desktop; do \
	  install -D -m 644 src/xdg/xfce4/xfconf/xfce-perchannel-xml/$$f.xml $(X)/xfconf/xfce-perchannel-xml/$$f.xml; \
	done
	install -D -m 644 src/xsession/55lightlix-xdg $(D)/etc/X11/Xsession.d/55lightlix-xdg
	install -D -m 644 src/autostart/lightlix-session-setup.desktop $(D)/etc/xdg/autostart/lightlix-session-setup.desktop
	install -D -m 644 src/autostart/lightlix-control-center-wizard.desktop $(D)/etc/xdg/autostart/lightlix-control-center-wizard.desktop
	install -D -m 644 src/lightdm/50-lightlix.conf $(D)/usr/share/lightdm/lightdm.conf.d/50-lightlix.conf
	install -D -m 644 src/lightdm/50-lightlix-greeter.conf $(D)/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-lightlix.conf
	install -D -m 755 src/lightdm/lightdm-live-autologin $(D)/usr/lib/lightlix/lightdm-live-autologin
	install -D -m 644 src/lightdm/lightdm-service-override.conf $(D)/usr/lib/systemd/system/lightdm.service.d/lightlix.conf
	install -D -m 755 src/lightlix-panel-net $(D)/usr/bin/lightlix-panel-net
	install -D -m 755 src/lightlix-session-setup $(D)/usr/bin/lightlix-session-setup
	install -D -m 644 src/themes/Lightlix/index.theme $(T)/index.theme
	install -D -m 644 src/themes/Lightlix/gtk-3.0/gtk.css $(T)/gtk-3.0/gtk.css
	install -D -m 644 src/themes/Lightlix/xfwm4/themerc $(T)/xfwm4/themerc
	set -e; for f in $(G)/*.png; do install -D -m 644 $$f $(T)/xfwm4/$$(basename $$f); done
