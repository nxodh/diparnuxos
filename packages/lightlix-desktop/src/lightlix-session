#!/bin/sh
# greetd 가 로그인 뒤 실행하는 labwc 세션 래퍼다. 설치 경로는 /usr/bin/lightlix-session 이다.
#
# - 세션 환경 변수를 정한다. tuigreet 의 --cmd 로 시작하면 XDG_SESSION_TYPE 이 비어 있어, 브라우저와 GTK/Qt 앱이
#   Wayland 세션임을 알아보지 못한다(예: Chrome 이 Wayland 를 쓰지 않거나 시작하지 못한다).
# - 가상 머신(VMware, VirtualBox, QEMU 등)에서는 GPU 렌더러와 하드웨어 커서가 컴포지터를 시작 직후 끝내는 일이 흔하다.
#   그래서 소프트웨어 렌더러(pixman)와 소프트웨어 커서를 기본으로 쓴다. 이미 지정된 값은 바꾸지 않는다.
#   실기에서는 아무것도 바꾸지 않는다.
# - labwc 의 출력은 저널(식별자 lightlix-labwc)로 보낸다. 램(tmpfs)의 파일에 쓰면 오류가 반복될 때 로그가 램을 무한정
#   차지할 수 있다. 시작 시점의 환경(가상화 종류, 렌더러)만 $XDG_RUNTIME_DIR/labwc.log 에 짧게 남긴다.
set -u

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=labwc
export XDG_CURRENT_DESKTOP=labwc:wlroots
# 브라우저와 Qt 앱이 Wayland 를 먼저 쓰게 한다. 없으면 XWayland(DISPLAY)로 떨어진다.
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export QT_QPA_PLATFORM="wayland;xcb"

if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt --quiet --vm; then
    : "${WLR_RENDERER:=pixman}"
    : "${WLR_NO_HARDWARE_CURSORS:=1}"
    export WLR_RENDERER WLR_NO_HARDWARE_CURSORS
fi

log="${XDG_RUNTIME_DIR:-/tmp}/labwc.log"
{
    echo "lightlix-session: $(date -u +%Y-%m-%dT%H:%M:%SZ) starting labwc"
    echo "lightlix-session: virt=$(systemd-detect-virt 2>/dev/null || echo unknown) WLR_RENDERER=${WLR_RENDERER:-} WLR_NO_HARDWARE_CURSORS=${WLR_NO_HARDWARE_CURSORS:-}"
    echo "lightlix-session: labwc output goes to the journal: journalctl -b -t lightlix-labwc"
} > "$log" 2>/dev/null || true

# labwc 와 그 자식의 출력은 저널로 보낸다. 저널은 램을 아끼려고 휘발성이고 크기(RuntimeMaxUse)와 속도(rate limit)가
# 제한되어 있어서, 오류가 계속 반복되어도 램을 무한정 쓰지 않는다. systemd-cat 이 없으면 /dev/null 로 버린다.
if command -v systemd-cat >/dev/null 2>&1; then
    exec systemd-cat -t lightlix-labwc labwc "$@"
fi
exec labwc "$@" >/dev/null 2>&1
