# shellcheck shell=sh
# /etc/X11/Xsession.d 에서 읽히는 조각이다(셸 파일로 불러 쓴다). 설치 경로는 /etc/X11/Xsession.d/55lightlix-xdg 다.
# Lightlix 의 Xfce 기본 설정 디렉터리(/etc/xdg/lightlix)를 Debian 의 /etc/xdg 보다 앞에 둔다.
# startxfce4 는 미리 정해진 XDG_CONFIG_DIRS 를 그대로 쓰고 끝에 /etc/xdg 만 덧붙인다.
case ":${XDG_CONFIG_DIRS:-}:" in
    *:/etc/xdg/lightlix:*) ;;
    *) XDG_CONFIG_DIRS="/etc/xdg/lightlix:${XDG_CONFIG_DIRS:-/etc/xdg}"; export XDG_CONFIG_DIRS ;;
esac
# 한글 입력기가 설치되어 있으면 GTK 와 Qt 앱이 쓰게 한다.
if [ -x /usr/bin/fcitx5 ]; then
    XMODIFIERS="@im=fcitx"; export XMODIFIERS
    GTK_IM_MODULE=fcitx; export GTK_IM_MODULE
    QT_IM_MODULE=fcitx; export QT_IM_MODULE
fi
