<?xml version="1.0"?>
<!-- Lightlix 의 labwc 기본 설정. 설치 경로는 /etc/xdg/labwc/rc.xml 이다. 사용자는 ~/.config/labwc/rc.xml 로 덮어쓸 수 있다. -->
<labwc_config>
  <theme>
    <name>Lightlix</name>
    <cornerRadius>6</cornerRadius>
    <font place="ActiveWindow"><name>NanumGothic</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>NanumGothic</name><size>10</size></font>
    <font place="MenuItem"><name>NanumGothic</name><size>11</size></font>
    <font place="OnScreenDisplay"><name>NanumGothic</name><size>10</size></font>
  </theme>
</labwc_config>
