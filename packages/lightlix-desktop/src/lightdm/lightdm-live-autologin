#!/bin/sh
# 라이브 세션에서만 라이브 사용자를 자동으로 로그인시킨다. 설치 경로는 /usr/lib/lightlix/lightdm-live-autologin 이다.
# lightdm.service 의 ExecStartPre 로 실행된다. 라이브가 아니면(설치된 시스템) 조각을 지운다.
# 조각은 /etc/lightdm/lightdm.conf.d 에 런타임에 쓰므로 squashfs 에 들어가지 않고 설치본으로 복사되지 않는다.
set -u
conf=/etc/lightdm/lightdm.conf.d/60-lightlix-live-autologin.conf
# /run/lightlix-no-autologin 이 있으면 라이브에서도 자동 로그인을 끈다(로그인 화면 시험, 진단용).
if [ ! -e /run/live ] || [ -e /run/lightlix-no-autologin ]; then
    rm -f "$conf"
    exit 0
fi
user=user
for parameter in $(cat /proc/cmdline 2>/dev/null); do
    case "$parameter" in
        live-config.username=*|username=*) user="${parameter#*username=}" ;;
    esac
done
if ! getent passwd "$user" >/dev/null 2>&1; then
    echo "lightlix-lightdm-live-autologin: live user does not exist: $user" >&2
    exit 0
fi
# lightdm 의 PAM 자동 로그인은 nopasswdlogin 그룹을 요구한다.
getent group nopasswdlogin >/dev/null 2>&1 || groupadd -r nopasswdlogin 2>/dev/null
usermod -a -G nopasswdlogin "$user" 2>/dev/null
mkdir -p "$(dirname "$conf")"
cat > "$conf" <<CONF
[Seat:*]
autologin-user=$user
autologin-user-timeout=0
autologin-session=xfce
CONF
exit 0
