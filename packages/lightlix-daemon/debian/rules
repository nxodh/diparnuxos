#!/usr/bin/make -f
# 모듈과 dist 원본은 build-debs.sh가 이 패키지의 daemon/에 복사한다.
LIGHTLIX_CONF ?= $(CURDIR)/../../lightlix.conf
export CGO_ENABLED = 1
export GOPROXY = off
export GOTOOLCHAIN = local
export GOFLAGS = -mod=vendor -trimpath -buildvcs=false

%:
	dh $@

override_dh_auto_configure:
	sh debian/gen-control.sh "$(LIGHTLIX_CONF)"

override_dh_auto_build:
	mkdir -p build
	set -e; . "$(LIGHTLIX_CONF)"; cd daemon; go build -ldflags "-X main.version=$$LIGHTLIX_VERSION" -o ../build/lightlixd ./cmd/lightlixd; go build -ldflags "-X main.version=$$LIGHTLIX_VERSION" -o ../build/lightlix ./cmd/lightlix; go build -o ../build/lightlix-update ./cmd/lightlix-update; go build -o ../build/lightlix-install ./cmd/lightlix-install

override_dh_auto_test:
	cd daemon && go test -count=1 ./...

override_dh_auto_install:
	install -D -m 755 build/lightlixd debian/lightlix-daemon/usr/sbin/lightlixd
	install -D -m 755 build/lightlix debian/lightlix-daemon/usr/bin/lightlix
	install -D -m 755 daemon/dist/lightlix-gpu-permissions.sh debian/lightlix-daemon/usr/lib/lightlix/check-gpu-permissions
	install -D -m 755 daemon/dist/lightlix-user.sh debian/lightlix-daemon/usr/lib/lightlix/lightlix-user
	install -D -m 755 build/lightlix-update debian/lightlix-daemon/usr/lib/lightlix/lightlix-update
	install -D -m 755 build/lightlix-install debian/lightlix-daemon/usr/sbin/lightlix-install
	install -D -m 644 daemon/dist/grub-lightlix.cfg debian/lightlix-daemon/etc/default/grub.d/20-lightlix.cfg
	install -D -m 644 daemon/dist/lightlix.sysusers.conf debian/lightlix-daemon/usr/lib/sysusers.d/lightlix.conf
	install -D -m 644 daemon/dist/lightlix-daemon.tmpfiles.conf debian/lightlix-daemon/usr/lib/tmpfiles.d/lightlix-daemon.conf
	install -D -m 644 daemon/dist/firewall-default.nft debian/lightlix-daemon/usr/share/lightlix/firewall-default.nft
	install -D -m 644 daemon/vendor/github.com/NVIDIA/go-nvml/LICENSE debian/lightlix-daemon/usr/share/doc/lightlix-daemon/go-nvml.LICENSE
	install -d debian/lightlix-daemon/usr/lib/systemd/system
	install -m 644 daemon/dist/*.service daemon/dist/*.socket debian/lightlix-daemon/usr/lib/systemd/system/

override_dh_installsystemd:
	# llama 유닛은 데몬이 시작한다. nftables.service의 flush ruleset과 경쟁하지 않는다.
	dh_installsystemd --no-start lightlixd.service lightlixd.socket lightlix-firewall-default.service lightlix-firewall.service lightlix-update-verify.service

override_dh_installtmpfiles:
	# compat 13의 기본 시퀀스에는 sysusers가 없다. 그룹을 디렉터리보다 먼저 만든다.
	dh_installsysusers
	dh_installtmpfiles

override_dh_dwz:
	# Go가 만든 압축 DWARF는 dwz가 처리하지 못한다. dh_strip은 그대로 실행한다.

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_compress:
	# 라이선스 원문은 문서에 안내한 경로에서 그대로 읽을 수 있게 둔다.
	dh_compress -Xgo-nvml.LICENSE

override_dh_auto_clean:
	rm -rf build
