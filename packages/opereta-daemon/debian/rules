#!/usr/bin/make -f
# 모듈과 dist 원본은 build-debs.sh가 이 패키지의 daemon/에 복사한다.
OPERETA_CONF ?= $(CURDIR)/../../opereta.conf
export CGO_ENABLED = 1
export GOPROXY = off
export GOTOOLCHAIN = local
export GOFLAGS = -mod=vendor -trimpath -buildvcs=false

%:
	dh $@

override_dh_auto_configure:
	sh debian/gen-control.sh "$(OPERETA_CONF)"

override_dh_auto_build:
	mkdir -p build
	set -e; . "$(OPERETA_CONF)"; cd daemon; go build -ldflags "-X main.version=$$OPERETA_VERSION" -o ../build/operetad ./cmd/operetad; go build -ldflags "-X main.version=$$OPERETA_VERSION" -o ../build/opereta ./cmd/opereta; go build -o ../build/opereta-update ./cmd/opereta-update; go build -o ../build/opereta-install ./cmd/opereta-install; go build -o ../build/opereta-admin ./cmd/opereta-admin

override_dh_auto_test:
	cd daemon && go test -count=1 ./...

override_dh_auto_install:
	install -D -m 755 build/operetad debian/opereta-daemon/usr/sbin/operetad
	install -D -m 755 build/opereta debian/opereta-daemon/usr/bin/opereta
	install -D -m 755 daemon/dist/opereta-gpu-permissions.sh debian/opereta-daemon/usr/lib/opereta/check-gpu-permissions
	install -D -m 755 daemon/dist/opereta-user.sh debian/opereta-daemon/usr/lib/opereta/opereta-user
	install -D -m 755 build/opereta-update debian/opereta-daemon/usr/lib/opereta/opereta-update
	install -D -m 755 build/opereta-install debian/opereta-daemon/usr/sbin/opereta-install
	install -D -m 755 build/opereta-admin debian/opereta-daemon/usr/lib/opereta/opereta-admin
	install -D -m 644 daemon/dist/grub-opereta.cfg debian/opereta-daemon/etc/default/grub.d/20-opereta.cfg
	install -D -m 644 daemon/dist/opereta.sysusers.conf debian/opereta-daemon/usr/lib/sysusers.d/opereta.conf
	install -D -m 644 daemon/dist/opereta-daemon.tmpfiles.conf debian/opereta-daemon/usr/lib/tmpfiles.d/opereta-daemon.conf
	install -D -m 644 daemon/dist/firewall-default.nft debian/opereta-daemon/usr/share/opereta/firewall-default.nft
	install -D -m 644 daemon/dist/50-opereta-always-on.logind.conf debian/opereta-daemon/usr/lib/systemd/logind.conf.d/50-opereta-always-on.conf
	install -D -m 644 daemon/dist/50-opereta-always-on.sleep.conf debian/opereta-daemon/usr/lib/systemd/sleep.conf.d/50-opereta-always-on.conf
	install -D -m 644 daemon/dist/skills/opereta/SKILL.md debian/opereta-daemon/usr/share/opereta/skills/opereta/SKILL.md
	# 새 계정이 Deberopa 등 에이전트의 스킬 목록에서 바로 찾도록 skel 에 링크를 둔다.
	install -d debian/opereta-daemon/etc/skel/.agents/skills
	ln -s /usr/share/opereta/skills/opereta debian/opereta-daemon/etc/skel/.agents/skills/opereta
	install -D -m 644 daemon/vendor/github.com/NVIDIA/go-nvml/LICENSE debian/opereta-daemon/usr/share/doc/opereta-daemon/go-nvml.LICENSE
	install -d debian/opereta-daemon/usr/lib/systemd/system
	install -m 644 daemon/dist/*.service daemon/dist/*.socket daemon/dist/*.timer debian/opereta-daemon/usr/lib/systemd/system/

override_dh_installsystemd:
	# llama 유닛은 데몬이 시작한다. nftables.service의 flush ruleset과 경쟁하지 않는다.
	dh_installsystemd --no-start operetad.service operetad.socket opereta-firewall-default.service opereta-firewall.service opereta-update-verify.service
	# 타이머는 설치하면 켜지고(다음 부팅부터 하루 한 번), 서비스는 타이머가 시작한다.
	dh_installsystemd opereta-deberopa-update.timer

override_dh_installtmpfiles:
	# compat 13의 기본 시퀀스에는 sysusers가 없다. 그룹을 디렉터리보다 먼저 만든다.
	dh_installsysusers
	dh_installtmpfiles

override_dh_dwz:
	# Go가 만든 압축 DWARF는 dwz가 처리하지 못한다. dh_strip은 그대로 실행한다.

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_compress:
	# 라이선스 원문은 문서에 안내한 경로에서 그대로 읽을 수 있게 둔다.
	dh_compress -Xgo-nvml.LICENSE

override_dh_auto_clean:
	rm -rf build
