#!/usr/bin/make -f
# opereta-base 패키지 규칙. 정체성 파일 값은 opereta.conf 에서 생성한다.
# OPERETA_CONF 가 환경 변수로 주어지면 그 경로를 쓰고, 없으면 저장소 루트의 opereta.conf 를 쓴다.

OPERETA_CONF ?= $(CURDIR)/../../opereta.conf

%:
	dh $@

override_dh_auto_build:
	# 빌드할 대상이 없다. 파일은 install 단계에서 생성한다.

override_dh_auto_install:
	sh debian/gen-identity.sh "$(OPERETA_CONF)" "$(CURDIR)/debian/opereta-base"
