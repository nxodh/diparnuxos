#!/usr/bin/make -f
# 모든 고정 버전은 diparnux.conf 에서 읽는다.
DIPARNUX_CONF ?= $(CURDIR)/../../diparnux.conf

%:
	dh $@

override_dh_auto_configure:
	sh debian/gen-control.sh "$(DIPARNUX_CONF)"

override_dh_auto_build:
	# 컴파일할 대상은 없다.

override_dh_auto_install:
	sh debian/gen-config.sh "$(DIPARNUX_CONF)" "$(CURDIR)/debian/diparnux-nvidia"
	install -D -m 755 src/gpu-check.sh debian/diparnux-nvidia/usr/sbin/diparnux-gpu-check
	install -D -m 644 src/diparnux-gpu-check.service debian/diparnux-nvidia/usr/lib/systemd/system/diparnux-gpu-check.service
	install -D -m 755 src/diparnux-mok.sh debian/diparnux-nvidia/usr/sbin/diparnux-mok

override_dh_installinit:
	# initramfs 재생성은 DKMS 검증 후 live-build 훅에서 한다.
