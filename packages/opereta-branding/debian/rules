#!/usr/bin/make -f
# 이미지는 저장소 루트의 assets/brand/generated 에서 가져온다. build-debs.sh 가 이 디렉터리를 임시 사본의 assets/ 로 복사한다.
DEST = debian/opereta-branding
G = assets/generated

%:
	dh $@

override_dh_auto_build:
	# 컴파일할 대상은 없다.

override_dh_auto_install:
	set -e; for n in 16 24 32 48 64 96 128 256 512; do \
	  install -D -m 644 $(G)/opereta-$$n.png $(DEST)/usr/share/icons/hicolor/$${n}x$${n}/apps/opereta.png; \
	done
	set -e; for n in 32 64 128 256; do \
	  install -D -m 644 $(G)/deberopa-$$n.png $(DEST)/usr/share/icons/hicolor/$${n}x$${n}/apps/deberopa.png; \
	done
	install -D -m 644 $(G)/opereta-128.png $(DEST)/usr/share/pixmaps/opereta.png
	install -D -m 644 $(G)/opereta-mark-white.png $(DEST)/usr/share/opereta/brand/opereta-mark-white.png
	install -D -m 644 $(G)/opereta-mark-black.png $(DEST)/usr/share/opereta/brand/opereta-mark-black.png
	install -D -m 644 $(G)/opereta-512.png $(DEST)/usr/share/opereta/brand/opereta-logo-512.png
	install -D -m 644 $(G)/wallpaper.png $(DEST)/usr/share/opereta/wallpaper.png
	install -D -m 644 src/opereta-live-hint.sh $(DEST)/etc/profile.d/opereta-live-hint.sh
	install -D -m 644 src/10-opereta-colors.cfg $(DEST)/etc/default/grub.d/10-opereta-colors.cfg
