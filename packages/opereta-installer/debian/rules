#!/usr/bin/make -f
# 설정 파일 복사만 한다. 브랜딩의 버전 문자열은 opereta.conf 의 값으로 채운다.
OPERETA_CONF ?= $(CURDIR)/../../opereta.conf
DEST = debian/opereta-installer

%:
	dh $@

override_dh_auto_build:
	# 컴파일할 대상은 없다.

override_dh_auto_install:
	install -D -m 644 src/settings.conf $(DEST)/etc/calamares/settings.conf
	for f in src/modules/*.conf; do install -D -m 644 "$$f" "$(DEST)/etc/calamares/modules/$$(basename $$f)"; done
	install -D -m 644 src/branding/branding.desc $(DEST)/etc/calamares/branding/opereta/branding.desc
	install -D -m 644 src/branding/show.qml $(DEST)/etc/calamares/branding/opereta/show.qml
	for f in src/branding/*.png; do install -D -m 644 "$$f" "$(DEST)/etc/calamares/branding/opereta/$$(basename $$f)"; done
	set -e; if [ -r "$(OPERETA_CONF)" ]; then . "$(OPERETA_CONF)"; \
	  sed -i "s/@VERSION@/$$OPERETA_VERSION/g" $(DEST)/etc/calamares/branding/opereta/branding.desc; \
	else sed -i "s/@VERSION@/dev/g" $(DEST)/etc/calamares/branding/opereta/branding.desc; fi
	install -D -m 755 src/opereta-installer.sh $(DEST)/usr/bin/opereta-installer
	install -D -m 644 src/opereta-installer.desktop $(DEST)/usr/share/applications/opereta-installer.desktop
