#!/usr/bin/make -f
# 파일 복사만 한다. 서비스 유닛은 lightdm 패키지가 소유한다. 라이브 자동 로그인은 live-config 의 lightdm 구성 요소가 맡는다.
# Debian 의 /etc/xdg 파일을 덮지 않도록 Diparnux 기본값은 /etc/xdg/diparnux 에 둔다.
D = debian/diparnux-desktop
X = $(D)/etc/xdg/diparnux/xfce4
T = $(D)/usr/share/themes/Diparnux
G = assets/generated/xfwm4

%:
	dh $@

override_dh_auto_build:
	# 컴파일할 대상은 없다.

override_dh_auto_install:
	install -D -m 644 src/xdg/xfce4/panel/default.xml $(X)/panel/default.xml
	install -D -m 644 src/xdg/xfce4/panel/genmon-5.rc $(X)/panel/genmon-5.rc
	install -D -m 644 src/xdg/xfce4/whiskermenu/defaults.rc $(X)/whiskermenu/defaults.rc
	install -D -m 644 src/xdg/xfce4/terminal/terminalrc $(X)/terminal/terminalrc
	set -e; for f in xsettings xfwm4 xfce4-desktop xfce4-power-manager; do \
	  install -D -m 644 src/xdg/xfce4/xfconf/xfce-perchannel-xml/$$f.xml $(X)/xfconf/xfce-perchannel-xml/$$f.xml; \
	done
	install -D -m 644 src/xsession/55diparnux-xdg $(D)/etc/X11/Xsession.d/55diparnux-xdg
	install -D -m 644 src/autostart/diparnux-session-setup.desktop $(D)/etc/xdg/autostart/diparnux-session-setup.desktop
	install -D -m 644 src/autostart/diparnux-control-center-wizard.desktop $(D)/etc/xdg/autostart/diparnux-control-center-wizard.desktop
	install -D -m 644 src/lightdm/50-diparnux.conf $(D)/usr/share/lightdm/lightdm.conf.d/50-diparnux.conf
	install -D -m 644 src/lightdm/50-diparnux-greeter.conf $(D)/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-diparnux.conf
	install -D -m 755 src/diparnux-panel-net $(D)/usr/bin/diparnux-panel-net
	install -D -m 755 src/diparnux-session-setup $(D)/usr/bin/diparnux-session-setup
	install -D -m 644 src/themes/Diparnux/index.theme $(T)/index.theme
	install -D -m 644 src/themes/Diparnux/gtk-3.0/gtk.css $(T)/gtk-3.0/gtk.css
	install -D -m 644 src/themes/Diparnux/xfwm4/themerc $(T)/xfwm4/themerc
	set -e; for f in $(G)/*.png; do install -D -m 644 $$f $(T)/xfwm4/$$(basename $$f); done
