#!/usr/bin/make -f
# 모듈과 dist 원본은 build-debs.sh가 이 패키지의 daemon/에 복사한다.
DIPARNUX_CONF ?= $(CURDIR)/../../diparnux.conf
export CGO_ENABLED = 1
export GOPROXY = off
export GOTOOLCHAIN = local
export GOFLAGS = -mod=vendor -trimpath -buildvcs=false

%:
	dh $@

override_dh_auto_configure:
	sh debian/gen-control.sh "$(DIPARNUX_CONF)"

override_dh_auto_build:
	mkdir -p build
	set -e; . "$(DIPARNUX_CONF)"; cd daemon; go build -ldflags "-X main.version=$$DIPARNUX_VERSION" -o ../build/diparnuxd ./cmd/diparnuxd; go build -ldflags "-X main.version=$$DIPARNUX_VERSION" -o ../build/diparnux ./cmd/diparnux; go build -o ../build/diparnux-update ./cmd/diparnux-update; go build -o ../build/diparnux-install ./cmd/diparnux-install

override_dh_auto_test:
	cd daemon && go test -count=1 ./...

override_dh_auto_install:
	install -D -m 755 build/diparnuxd debian/diparnux-daemon/usr/sbin/diparnuxd
	install -D -m 755 build/diparnux debian/diparnux-daemon/usr/bin/diparnux
	install -D -m 755 daemon/dist/diparnux-gpu-permissions.sh debian/diparnux-daemon/usr/lib/diparnux/check-gpu-permissions
	install -D -m 755 daemon/dist/diparnux-user.sh debian/diparnux-daemon/usr/lib/diparnux/diparnux-user
	install -D -m 755 build/diparnux-update debian/diparnux-daemon/usr/lib/diparnux/diparnux-update
	install -D -m 755 build/diparnux-install debian/diparnux-daemon/usr/sbin/diparnux-install
	install -D -m 644 daemon/dist/grub-diparnux.cfg debian/diparnux-daemon/etc/default/grub.d/20-diparnux.cfg
	install -D -m 644 daemon/dist/diparnux.sysusers.conf debian/diparnux-daemon/usr/lib/sysusers.d/diparnux.conf
	install -D -m 644 daemon/dist/diparnux-daemon.tmpfiles.conf debian/diparnux-daemon/usr/lib/tmpfiles.d/diparnux-daemon.conf
	install -D -m 644 daemon/dist/firewall-default.nft debian/diparnux-daemon/usr/share/diparnux/firewall-default.nft
	install -D -m 644 daemon/dist/50-diparnux-always-on.logind.conf debian/diparnux-daemon/usr/lib/systemd/logind.conf.d/50-diparnux-always-on.conf
	install -D -m 644 daemon/dist/50-diparnux-always-on.sleep.conf debian/diparnux-daemon/usr/lib/systemd/sleep.conf.d/50-diparnux-always-on.conf
	install -D -m 644 daemon/vendor/github.com/NVIDIA/go-nvml/LICENSE debian/diparnux-daemon/usr/share/doc/diparnux-daemon/go-nvml.LICENSE
	install -d debian/diparnux-daemon/usr/lib/systemd/system
	install -m 644 daemon/dist/*.service daemon/dist/*.socket debian/diparnux-daemon/usr/lib/systemd/system/

override_dh_installsystemd:
	# llama 유닛은 데몬이 시작한다. nftables.service의 flush ruleset과 경쟁하지 않는다.
	dh_installsystemd --no-start diparnuxd.service diparnuxd.socket diparnux-firewall-default.service diparnux-firewall.service diparnux-update-verify.service

override_dh_installtmpfiles:
	# compat 13의 기본 시퀀스에는 sysusers가 없다. 그룹을 디렉터리보다 먼저 만든다.
	dh_installsysusers
	dh_installtmpfiles

override_dh_dwz:
	# Go가 만든 압축 DWARF는 dwz가 처리하지 못한다. dh_strip은 그대로 실행한다.

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_compress:
	# 라이선스 원문은 문서에 안내한 경로에서 그대로 읽을 수 있게 둔다.
	dh_compress -Xgo-nvml.LICENSE

override_dh_auto_clean:
	rm -rf build
