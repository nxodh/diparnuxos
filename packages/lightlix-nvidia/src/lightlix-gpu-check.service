# GPU 진단은 로그인 프롬프트보다 먼저 끝나야 안내 파일이 프롬프트 위에 보인다.
# 종료 코드 1(GPU 없음)과 2(GPU 있으나 사용 불가)는 실패로 보지 않는다. 3 은 실패다.
[Unit]
Description=Lightlix NVIDIA driver and GPU check
After=systemd-udev-trigger.service systemd-modules-load.service systemd-tmpfiles-setup.service
Before=getty.target systemd-user-sessions.service multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/lightlix-gpu-check
SuccessExitStatus=1 2
RemainAfterExit=yes
# 스크립트의 timeout 합계(최대 약 110초)보다 길게 둔다. 그래야 상태 파일을 쓰기 전에 죽지 않는다.
TimeoutStartSec=120
StandardOutput=journal+console
StandardError=journal+console
ProtectHome=yes
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
