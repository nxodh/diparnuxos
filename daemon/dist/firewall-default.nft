# Lightlix nftables rules. Generated by lightlixd; do not edit by hand.
# Manages only table inet lightlix. Other tables are not touched.
table inet lightlix
delete table inet lightlix
table inet lightlix {
	chain input {
		type filter hook input priority filter; policy drop;
		iif lo accept
		ct state established,related accept
		ct state invalid drop
		# ICMP (IPv4) and ICMPv6 (IPv6), needed for neighbor discovery and path MTU.
		meta l4proto { icmp, icmpv6 } accept
		# DHCPv4 and DHCPv6 replies to this client.
		udp dport 68 accept
		udp dport 546 accept
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
	}
	chain output {
		type filter hook output priority filter; policy accept;
	}
}
