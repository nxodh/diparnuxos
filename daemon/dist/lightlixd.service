# 데몬 lightlixd 다. 설치 경로는 /usr/lib/systemd/system/lightlixd.service 다.
[Unit]
Description=Lightlix daemon (lightlixd)
# 소켓이 먼저 만들어져야 데몬이 넘겨받을 수 있다. Requires 만으로는 시작 순서가 정해지지 않으므로 After 도 적는다.
Requires=lightlixd.socket lightlix-firewall-default.service
After=lightlixd.socket lightlix-gpu-check.service lightlix-firewall-default.service lightlix-firewall.service network.target

[Service]
# 데몬은 소켓 활성화만으로 뜨지 않는다. 부팅 때 모델을 자동으로 띄우려면 multi-user.target 에서 시작해야 한다.
Type=simple
# 데몬은 root 로 돈다. systemctl 로 llama 유닛을 띄우고, nft 로 방화벽을 바꾸고, 모델 디렉터리에 쓴다.
ExecStart=/usr/sbin/lightlixd
# 새 모델 파일은 디렉터리의 그룹을 상속하며 그룹만 읽는다.
UMask=0027
# 비정상 종료만 다시 시작한다. 정상 종료(관리자가 멈춤)는 다시 띄우지 않는다.
Restart=on-failure
# 데몬과 그 자식(systemctl, nft)이 권한을 올리지 못하게 한다. 둘 다 setuid 바이너리에 기대지 않는다.
# systemctl 은 PID 1 과 D-Bus 로 통신한다. 실 기기에서 systemctl 호출이 이 옵션 아래에서 되는지는 미확인이다.
NoNewPrivileges=yes
# 사용자 홈 디렉터리를 보이지 않게 한다. 데몬은 홈 디렉터리를 쓰지 않는다.
ProtectHome=yes
# 데몬 전용 /tmp 를 쓴다. 다른 서비스와 임시 파일을 공유하지 않는다.
PrivateTmp=yes
# /usr, /boot, /efi, /etc 를 읽기 전용으로 만든다. 쓸 곳은 아래 ReadWritePaths 로만 연다.
# /run 은 이 옵션의 대상이 아니므로 /run/lightlix 에는 계속 쓸 수 있다.
ProtectSystem=full
# 모델 디렉터리(모델, .default, 사이드카, firewall.nft 가 있는 곳)와 설정 디렉터리(/etc/lightlix/lightlixd.json)에 쓴다.
# /var/lib/iwd 는 Wi-Fi 비밀번호 설정 파일(네트워크 GUI 와 lightlix network wifi connect 가 쓴다)이다. iwd 가 시작하기 전에는
# 없을 수 있으므로 앞의 - 로 없어도 시작하게 한다.
ReadWritePaths=/var/lib/lightlix /etc/lightlix -/var/lib/iwd
# /proc/sys 와 /sys 의 튜너블을 읽기 전용으로 만든다. 데몬은 sysctl 을 바꾸지 않는다.
ProtectKernelTunables=yes
# cgroup 파일 시스템을 읽기 전용으로 만든다. cgroup 은 systemd 가 관리하므로 데몬이 쓸 일이 없다.
ProtectControlGroups=yes
# 소켓 주소 체계를 제한한다. AF_UNIX 는 D-Bus 와 제어 소켓, AF_INET 과 AF_INET6 은 Hugging Face 의 HTTPS,
# AF_NETLINK 은 nft 가 nf_tables 와 통신할 때 쓴다. nft 는 데몬의 자식이라 이 제한을 물려받으므로 빠뜨리면 안 된다.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# setuid, setgid 비트가 붙은 파일을 만들지 못하게 한다. 데몬은 그런 파일을 만들지 않는다.
RestrictSUIDSGID=yes
# 프로세스 personality 를 바꾸지 못하게 한다. 데몬에는 필요 없다.
LockPersonality=yes
# 실시간 스케줄링 정책을 요청하지 못하게 한다. 데몬에는 필요 없다.
RestrictRealtime=yes
# 커널 로그, 시계, 호스트 이름을 건드리지 못하게 한다. 데몬은 시계를 맞추지 않고 호스트 이름도 바꾸지 않는다.
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
# 이 머신의 기본 아키텍처 시스템 호출만 허용한다. 다른 ABI 로 우회하는 경로를 막는다.
SystemCallArchitectures=native
# PrivateDevices 는 쓰지 않는다. 데몬은 NVML 로 /dev/nvidia* 를 열어 GPU 상태를 읽는다.
# PrivateDevices=yes 로 장치 노드를 가리면 GPU 상태를 읽지 못해 "GPU 없음"으로 잘못 판단한다.
# ProtectProc 도 쓰지 않는다. 데몬은 GPU 프로세스의 PID 를 /proc 에서 읽을 수 있어야 한다.

[Install]
WantedBy=multi-user.target
