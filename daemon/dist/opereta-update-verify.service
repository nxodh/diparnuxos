# 갱신 뒤 첫 부팅을 확인하는 유닛이다. 설치 경로는 /usr/lib/systemd/system/opereta-update-verify.service 다.
# 상태가 pending_boot 가 아니면 아무 일도 하지 않고 성공으로 끝난다.
# 새 커널이 계획대로 부팅했고 드라이버 모듈이 적재되면 기본 부팅 커널을 새 커널로 확정한다.
[Unit]
Description=Opereta post-update boot verification
After=opereta-gpu-check.service nvidia-persistenced.service
ConditionPathExists=/var/lib/opereta/update/state.json
# 라이브 세션에서는 갱신하지 않는다.
ConditionPathExists=!/run/live

[Service]
Type=oneshot
ExecStart=/usr/lib/opereta/opereta-update verify
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
