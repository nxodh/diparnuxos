# 데몬 제어 소켓이다. 설치 경로는 /usr/lib/systemd/system/diparnuxd.socket 이다.
# 소켓은 systemd 가 먼저 만들고, 데몬은 시작할 때 그 파일 디스크립터를 넘겨받는다(socket activation).
[Unit]
Description=Diparnux daemon control socket

[Socket]
# /run/diparnux 는 tmpfiles 가 부팅 때 만든다. 이 파일은 diparnux-nvidia 패키지가 만든 디렉터리 안에 생긴다.
ListenStream=/run/diparnux/diparnuxd.sock
# 소유자(root)는 읽고 쓰고, 그룹 diparnux 도 읽고 쓴다. 그 밖의 사용자는 접근할 수 없다.
SocketMode=0660
SocketGroup=diparnux

[Install]
WantedBy=sockets.target
