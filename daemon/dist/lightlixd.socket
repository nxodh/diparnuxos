# 데몬 제어 소켓이다. 설치 경로는 /usr/lib/systemd/system/lightlixd.socket 이다.
# 소켓은 systemd 가 먼저 만들고, 데몬은 시작할 때 그 파일 디스크립터를 넘겨받는다(socket activation).
[Unit]
Description=Lightlix daemon control socket

[Socket]
# /run/lightlix 는 tmpfiles 가 부팅 때 만든다. 이 파일은 lightlix-nvidia 패키지가 만든 디렉터리 안에 생긴다.
ListenStream=/run/lightlix/lightlixd.sock
# 소유자(root)는 읽고 쓰고, 그룹 lightlix 도 읽고 쓴다. 그 밖의 사용자는 접근할 수 없다.
SocketMode=0660
SocketGroup=lightlix

[Install]
WantedBy=sockets.target
