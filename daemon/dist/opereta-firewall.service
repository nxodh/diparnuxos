# 저장된 방화벽 규칙을 적용한다. 설치 경로는 /usr/lib/systemd/system/opereta-firewall.service 다.
# 기본 차단이 성공한 뒤 저장 파일이 있을 때만 덮어쓴다. nft의 트랜잭션 실패는 기본 규칙을 유지한다.
[Unit]
Description=Opereta nftables rules (saved rules)
# 기본 의존성(sysinit, shutdown 등)을 끄고 직접 적는다. 네트워크보다 먼저 방화벽을 적용해야 하는 초기 부팅 유닛이다.
DefaultDependencies=no
# 파일을 읽으려면 로컬 파일 시스템이 올라와 있어야 한다. /var 가 별도 마운트일 수 있으므로 local-fs 를 기다린다.
Requires=opereta-firewall-default.service
After=local-fs.target opereta-firewall-default.service
# 네트워크가 올라오기 전에 규칙을 적용한다.
Before=network-pre.target
Wants=network-pre.target
# 종료할 때는 이 유닛을 먼저 끝내지 않는다. 종료 시 규칙을 지우면 종료 중 네트워크가 열린다.
Before=shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/var/lib/opereta/firewall.nft

[Service]
Type=oneshot
# 규칙을 적용한 뒤에도 유닛을 active 로 둔다. 상태를 보면 방화벽이 적용되었는지 알 수 있다.
RemainAfterExit=yes
# -f 는 파일의 규칙을 읽는다. 파일은 table inet opereta 만 다루며 먼저 지우고 다시 정의하므로 여러 번 적용해도 같다.
ExecStart=/usr/sbin/nft -f /var/lib/opereta/firewall.nft

[Install]
WantedBy=sysinit.target
